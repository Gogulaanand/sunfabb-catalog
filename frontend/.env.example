# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── Backend ─────────────────────────────────────────────────────────────────

# URL of the NestJS backend. Trailing slash optional.
# Note: the code reads NEXT_PUBLIC_API_URL (not NEXT_PUBLIC_BACKEND_URL).
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ─── Storefront mode ─────────────────────────────────────────────────────────

# Production must choose the public release mode explicitly. Lead-generation
# mode hides commerce UI and uses enquiry CTAs; transactional mode is only for a
# release whose payment and operations gates are complete.
NEXT_PUBLIC_STOREFRONT_MODE="CATALOG_LEAD_GEN"

# ─── SEO & Analytics ─────────────────────────────────────────────────────────

# Canonical origin used in sitemap.xml, robots.txt, and JSON-LD schemas.
# Must match the production domain exactly (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://sunfabb.com"

# GA4 Measurement ID (G-XXXXXXXXXX). Leave blank to disable analytics.
# Owner action: create a GA4 property at analytics.google.com to get this.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ─── Contact Us ──────────────────────────────────────────────────────────────

# Cloudflare Turnstile site key — rendered client-side in the contact form.
# Dev test key (always passes, shows widget):  1x00000000000000000000AA
# Dev failure key (always fails):              2x00000000000000000000AB
# Production key: get from dash.cloudflare.com > Turnstile (pair with backend TURNSTILE_SECRET_KEY).
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Optional until the owner supplies the real WhatsApp Business number. The
# product enquiry CTA validates the configured international number.
NEXT_PUBLIC_WHATSAPP_NUMBER="917010735152"

# Owner-approved public contact details. These may also be overridden by the
# verified defaults in frontend/lib/site-config.ts. Never place GSTIN, Resend
# API keys, payment credentials, or private notification addresses here.
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY="+91 70107 35152"
NEXT_PUBLIC_CONTACT_PHONE_E164="+917010735152"
NEXT_PUBLIC_CONTACT_EMAIL="sunfabb@gmail.com"
NEXT_PUBLIC_ADDRESS_LINES="31, Gandhiji street, Ingur road, Chennimalai, Erode - 638051"
NEXT_PUBLIC_MAPS_URL="https://maps.app.goo.gl/4Tj5dc8vD6t2WzBw6"
NEXT_PUBLIC_BUSINESS_HOURS="Mon to Sat - 9:00 am to 6:00 pm"
